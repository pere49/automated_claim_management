# Direct dependencies, one line each with the reason it is here.
# requirements.txt is the exact, pinned set installed in .venv (pip freeze).
# Install is a one-time, online, developer step; the application never uses the network.

pymupdf                  # render PDF pages to images (import pymupdf, never fitz)
pdfplumber               # extract claim table headers, rows, and totals from PDFs
pillow                   # load single-image files
pillow-heif              # HEIC photos from phones, for pillow
opencv-python-headless   # page measurement and image preparation before OCR
numpy                    # image arrays
rapidocr                 # the OCR engine (PaddleOCR models) - the only engine; Tesseract was measured and dropped
onnxruntime              # runs RapidOCR's models on the CPU
openpyxl                 # reading the claim Excel file (Stage C)
python-docx              # on the original list; no code uses it yet
PySide6-Essentials       # the review window (blueprint section 7). The Essentials build holds the core Qt modules this interface uses (widgets, graphics view) at about half the size of full PySide6. Added 2026-09-23 for GUI Stage A.
